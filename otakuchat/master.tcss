Screen {
    layout: vertical;
    background: $surface;
}

#chat-output {
    height: 1fr;
    border: solid #8b5cf6;
    margin: 1;
    padding: 1;
}

#main-l1 {
    text-style: bold;
    padding: 1 2;
    color: #a855f7;
}

#main-i1 {
    dock: bottom;
    margin: 1;
    border: tall #06b6d4;
}

PromptEditor {
    layout: vertical;
    background: $surface;
}

#prompt-editor-area {
    height: 1fr;
    border: solid #8b5cf6;
    margin: 1;
}

#prompt-cheat-sheet {
    dock: bottom;
    padding: 0 2;
    text-style: bold;
    background: $panel;
    color: #06b6d4;
}

ListPicker {
    layout: vertical;
    background: $surface;
}

ListPicker #picker-header {
    text-style: bold;
    padding: 1 2;
    color: #a855f7;
}

ListPicker #picker-list {
    height: 1fr;
    border: solid #8b5cf6;
    margin: 1 1 0 1;
}

#picker-search {
    margin: 0 1 1 1;
    border: tall #06b6d4;
}

ModalListPicker #picker-list {
    height: 12;
    border: solid #8b5cf6;
    margin-bottom: 1;
}

ModalListPicker #picker-search {
    border: tall #06b6d4;
}

ModalListPicker, TextPrompt, ConfirmDialog {
    align: center middle;
}

#picker-c1, #iptr-c1, #confirm-c1 {
    width: 60%;
    height: auto;
    border: solid #8b5cf6;
    padding: 1 2;
    background: $surface;
}

ModalListPicker #picker-header, #iptr-l1, #confirm-l1 {
    text-style: bold;
    color: #a855f7;
    padding-bottom: 1;
}

#confirm-hint {
    color: $text-muted;
}

