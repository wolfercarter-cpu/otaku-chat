Screen {
    layout: vertical;
    background: $surface;
}

#chat-output {
    height: 1fr;
    border: solid #8b5cf6;
    margin: 1;
    padding: 1;
}

#main-l1 {
    text-style: bold;
    padding: 1 2;
    color: #a855f7;
}

#main-i1 {
    dock: bottom;
    margin: 1;
    border: tall #06b6d4;
}

PromptEditor {
    layout: vertical;
    background: $surface;
}

#prompt-editor-area {
    height: 1fr;
    border: solid #8b5cf6;
    margin: 1;
}

#prompt-cheat-sheet {
    dock: bottom;
    padding: 0 2;
    text-style: bold;
    background: $panel;
    color: #06b6d4;
}

SessionBrowser, ModelPicker {
    layout: vertical;
    background: $surface;
}

#sess-header, #model-header {
    text-style: bold;
    padding: 1 2;
    color: #a855f7;
}

#session-list, #model-list {
    height: 1fr;
    border: solid #8b5cf6;
    margin: 1;
}

RenameSession {
    align: center middle;
}

#rename-container {
    width: 60%;
    height: auto;
    border: solid #8b5cf6;
    padding: 1 2;
    background: $surface;
}

#rename-header {
    text-style: bold;
    color: #a855f7;
    padding-bottom: 1;
}

