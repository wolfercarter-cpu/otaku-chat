Screen {
    layout: vertical;
    background: $surface;
}

#chat-scroll {
    height: 1fr;
    border: solid #8b5cf6;
    margin: 1;
}

#chat-output {
    height: auto;
    padding: 1;
}

#main-l1 {
    text-style: bold;
    padding: 1 2;
    color: #a855f7;
}

#main-i1 {
    dock: bottom;
    margin: 1;
    border: tall #06b6d4;
    width: 100%;
}

PromptEditor {
    layout: vertical;
    background: $surface;
}

#prompt-editor-area {
    height: 1fr;
    border: solid #8b5cf6;
    margin: 1;
}

#prompt-cheat-sheet {
    dock: bottom;
    padding: 0 2;
    text-style: bold;
    background: $panel;
    color: #06b6d4;
}

ListPicker {
    layout: vertical;
    background: $surface;
}

ListPicker #picker-header {
    text-style: bold;
    padding: 1 2;
    color: #a855f7;
}

ListPicker #picker-list {
    height: 1fr;
    border: solid #8b5cf6;
    margin: 1 1 0 1;
}

#picker-search {
    margin: 0 1 1 1;
    border: tall #06b6d4;
}

ModalListPicker #picker-list {
    height: 12;
    border: solid #8b5cf6;
    margin-bottom: 1;
}

ModalListPicker #picker-search {
    border: tall #06b6d4;
}

ModalListPicker, TextPrompt, ConfirmDialog {
    align: center middle;
}

#picker-c1, #iptr-c1, #confirm-c1, #faas-confirm-c1, #faas-result-c1 {
    width: 60%;
    height: auto;
    border: solid #8b5cf6;
    padding: 1 2;
    background: $surface;
}

ModalListPicker #picker-header, #iptr-l1, #confirm-l1, #faas-confirm-l1, #faas-result-l1 {
    text-style: bold;
    color: #a855f7;
    padding-bottom: 1;
}

#confirm-hint, #faas-confirm-hint, #faas-result-hint {
    color: $text-muted;
}

#faas-confirm-l2 {
    color: #06b6d4;
    padding-bottom: 1;
}

#faas-result-l2 {
    padding-bottom: 1;
}

Slate {
    layout: vertical;
    background: $surface;
}

#editor-cheat-sheet {
    dock: top;
    width: 100%;
    height: 1;
    background: $panel;
    color: #06b6d4;
    content-align: center middle;
}

#leap-box {
    width: 100%;
    border: none;
    border-bottom: solid #8b5cf6;
    background: $panel;
    padding: 0 1;
}

#leap-box > .input--placeholder {
    color: #06b6d4;
    text-style: italic;
}

#leap-box:focus {
    border-bottom: solid #a855f7;
}

#editor {
    width: 100%;
    height: 1fr;
    border: none;
    background: $surface;
}

VaultManager {
    layout: vertical;
    background: $surface;
}

#vault-header {
    text-style: bold;
    padding: 1 2;
    color: #a855f7;
}

#vault-search {
    margin: 0 1 1 1;
    border: tall #06b6d4;
}

#vault-list {
    height: 1fr;
    border: solid #8b5cf6;
    margin: 0 1 1 1;
}

#vault-status {
    padding: 0 2;
    color: $text-muted;
}

#vault-actions {
    height: auto;
    padding: 1;
    align: center middle;
}

#vault-actions Button {
    margin: 0 1;
}

#vault-import-c1 {
    width: 70%;
    height: auto;
    border: solid #8b5cf6;
    padding: 1 2;
    background: $surface;
}

#vault-import-l1 {
    text-style: bold;
    color: #a855f7;
    padding-bottom: 1;
}

